+#[test]
+fn keyboard_copy_mode_ctrl_e_y_scroll_one_line_keeping_the_cursor_text_line() {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    state.set_snapshot(Box::new(snapshot()));
+    let mut pane_surface = surface();
+    pane_surface.panes[0].scroll = Some(crate::protocol::PaneSurfaceScrollMetrics {
+        offset_from_bottom: 0,
+        max_offset_from_bottom: 20,
+        viewport_rows: 2,
+    });
+    state.set_pane_surface(pane_surface);
+    state.compose(106, 20).expect("composed frame");
+    let mut enter = ClientShellInput::default();
+    state.record_binding(
+        crate::input::KeybindMatch::Action(crate::input::KeybindAction::CopyMode),
+        &mut enter,
+    );
+    let key = |c| {
+        RawInputEvent::Key(crate::input::TerminalKey::new(
+            KeyCode::Char(c),
+            KeyModifiers::CONTROL,
+        ))
+    };
+    let cursor_and_offset = |state: &ClientShellState| {
+        state
+            .copy_mode
+            .as_ref()
+            .map(|mode| (mode.cursor.row, mode.offset_from_bottom))
+    };
+    assert_eq!(cursor_and_offset(&state), Some((21, 0)));
+
+    let at_bottom = state.handle_raw_events(vec![key('e')]);
+    assert_eq!(state.mode, ClientShellMode::Copy);
+    assert!(at_bottom.actions.is_empty());
+    assert_eq!(cursor_and_offset(&state), Some((21, 0)));
+
+    let up = state.handle_raw_events(vec![key('y')]);
+    assert_eq!(state.mode, ClientShellMode::Copy);
+    assert!(matches!(
+        &up.actions[..],
+        [ClientShellAction::Endpoint { request, .. }]
+            if matches!(
+                &request.method,
+                crate::api::schema::Method::PaneScroll(params)
+                    if params.offset_from_bottom == 1
+            )
+    ));
+    assert_eq!(cursor_and_offset(&state), Some((20, 1)));
+
+    state.handle_raw_events(vec![key('y')]);
+    assert_eq!(cursor_and_offset(&state), Some((19, 2)));
+
+    state.handle_raw_events(vec![key('e')]);
+    assert_eq!(cursor_and_offset(&state), Some((19, 1)));
+}
